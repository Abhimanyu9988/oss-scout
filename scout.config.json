{
  "title": "Contrib scout",
  "github_user": "Abhimanyu9988",
  "quiet_days": 45,
  "stale_review_days": 7,
  "max_issues_per_label": 60,
  "post_when_empty": false,
  "deliver": [
    "github"
  ],
  "board_repo": "Abhimanyu9988/oss-scout",
  "repos": [
    {
      "repo": "open-telemetry/opentelemetry-collector-contrib",
      "labels": [
        "receiver/kubeletstats",
        "receiver/k8scluster",
        "processor/k8sattributes",
        "receiver/k8sobjects",
        "receiver/k8sevents",
        "internal/k8sinventory",
        "extension/k8sobserver",
        "receiver/sqlserver",
        "receiver/flinkmetrics"
      ]
    },
    {
      "repo": "open-telemetry/semantic-conventions",
      "labels": [
        "area:k8s",
        "area:db"
      ],
      "keywords": [
        "container",
        "pod",
        "db",
        "sql",
        "stored_procedure"
      ]
    }
  ],
  "discover": {
    "orgs": [
      "open-telemetry",
      "kubernetes",
      "kubernetes-sigs"
    ],
    "labels": [
      "good first issue",
      "help wanted"
    ],
    "max_age_days": 90,
    "limit": 30,
    "languages": [
      "go"
    ]
  },
  "ping_after_days": 7,
  "claim_reminder_days": 14,
  "waiting_days": 7,
  "triage": {
    "days": 7,
    "keywords": [
      "kubelet",
      "k8s",
      "kubernetes",
      "sqlserver",
      "flink"
    ],
    "repos": [
      {
        "repo": "open-telemetry/opentelemetry-collector",
        "keywords": [
          "kubelet",
          "k8s",
          "kubernetes",
          "sqlserver",
          "flink"
        ]
      },
      {
        "repo": "open-telemetry/opentelemetry-helm-charts"
      }
    ]
  },
  "blocking_labels": [
    "waiting for author",
    "waiting-for:semantic-conventions",
    "waiting-for-code-owners",
    "discussion needed",
    "needs discussion",
    "triage:needs-triage"
  ]
}
