{
  "title": "Contrib scout",
  "github_user": "Abhimanyu9988",
  "quiet_days": 45,
  "stale_review_days": 7,
  "max_issues_per_label": 60,
  "post_when_empty": false,
  "deliver": [
    "github"
  ],
  "board_repo": "Abhimanyu9988/oss-scout",
  "repos": [
    {
      "repo": "open-telemetry/opentelemetry-collector-contrib",
      "labels": [
        "receiver/kubeletstats",
        "receiver/k8scluster",
        "processor/k8sattributes",
        "receiver/k8sobjects",
        "receiver/k8sevents",
        "internal/k8sinventory",
        "extension/k8sobserver",
        "receiver/sqlserver",
        "receiver/flinkmetrics",
        "exporter/splunkhec",
        "receiver/splunkhec"
      ]
    },
    {
      "repo": "open-telemetry/semantic-conventions",
      "labels": [
        "area:k8s",
        "area:db"
      ],
      "keywords": [
        "container",
        "pod",
        "db",
        "sql",
        "stored_procedure"
      ]
    }
  ],
  "discover": {
    "orgs": [
      "open-telemetry",
      "kubernetes",
      "kubernetes-sigs"
    ],
    "labels": [
      "good first issue",
      "help wanted"
    ],
    "max_age_days": 90,
    "limit": 30,
    "languages": [
      "go"
    ]
  },
  "ping_after_days": 7,
  "claim_reminder_days": 14,
  "waiting_days": 7,
  "triage": {
    "days": 7,
    "keywords": [
      "kubelet",
      "k8s",
      "kubernetes",
      "sqlserver",
      "flink"
    ],
    "repos": [
      {
        "repo": "open-telemetry/opentelemetry-collector",
        "keywords": [
          "kubelet",
          "k8s",
          "kubernetes",
          "sqlserver",
          "flink"
        ]
      },
      {
        "repo": "open-telemetry/opentelemetry-helm-charts"
      }
    ]
  },
  "blocking_labels": [
    "waiting for author",
    "waiting-for:semantic-conventions",
    "waiting-for-code-owners",
    "discussion needed",
    "needs discussion",
    "triage:needs-triage"
  ],
  "watches": [
    {
      "name": "Kubernetes v1.39 Release Team shadow application",
      "from": "2026-10-17",
      "until": "2027-01-31",
      "note": "The sign-up form is posted in the last week of v1.38 or the first week of v1.39 (dev@kubernetes.io and #sig-release). Read the Release Signal and Comms handbooks, then apply the same day.",
      "sources": [
        {
          "type": "github_path",
          "label": "v1.39 release folder in sig-release",
          "repo": "kubernetes/sig-release",
          "path": "releases/release-1.39"
        },
        {
          "type": "github_search",
          "label": "sig-release issues and PRs about v1.39 shadows",
          "query": "repo:kubernetes/sig-release 1.39 shadow"
        },
        {
          "type": "github_search",
          "label": "sig-release issues and PRs about the v1.39 release team",
          "query": "repo:kubernetes/sig-release \"1.39\" \"release team\" in:title"
        },
        {
          "type": "feed",
          "label": "dev@kubernetes.io",
          "url": "https://groups.google.com/a/kubernetes.io/g/dev/feed/rss_v2_0_msgs.xml",
          "all": [
            "shadow"
          ]
        }
      ]
    }
  ]
}
